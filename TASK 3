import os
import tempfile


class InvalidRecord(Exception):
    """Invalid attendance record."""


def parse_line(line):

    parts = line.strip().split(",")

    if len(parts) != 3:
        raise InvalidRecord(
            f"expected 3 fields, found {len(parts)}"
        )

    register_no, date, status = parts

    if status not in ["P", "A"]:
        raise InvalidRecord(
            f"invalid status '{status}'"
        )

    return register_no, date, status


def summarise(path):

    present = 0
    absent = 0
    errors = []

    try:

        with open(path, "r", encoding="utf-8") as file:

            for line_no, line in enumerate(file, start=1):

                if not line.strip():
                    continue

                try:

                    reg_no, date, status = parse_line(line)

                    if status == "P":
                        present += 1
                    else:
                        absent += 1

                except InvalidRecord as error:
                    errors.append((line_no, str(error)))

    except FileNotFoundError as error:
        raise FileNotFoundError(
            f"File not found: {path}"
        ) from error

    except PermissionError as error:
        raise PermissionError(
            f"Permission denied: {path}"
        ) from error

    except UnicodeDecodeError as error:
        raise ValueError(
            "Invalid file encoding"
        ) from error

    finally:
        pass

    return present, absent, errors


data = (
    "192311001,2026-10-08,P\n"
    "192311002,2026-10-08,A\n"
    "192311003,2026-10-08\n"
    "192311004,2026-10-08,L\n"
)

with tempfile.NamedTemporaryFile(
    "w",
    suffix=".csv",
    delete=False,
    encoding="utf-8"
) as tmp:

    tmp.write(data)
    filename = tmp.name


try:
    print(summarise(filename))

finally:
    os.remove(filename)
